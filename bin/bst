#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
TOOLS_ROOT="${BST_TOOLS_ROOT:-$HOME/.cache/amphora-buildstream/tools}"
BST="$TOOLS_ROOT/venv/bin/bst"
export PATH="$TOOLS_ROOT/venv/bin:$TOOLS_ROOT/bin:$PATH"

if [ ! -x "$BST" ]; then
    echo "BuildStream tools missing; run scripts/install-buildstream.sh" >&2
    exit 1
fi

exec "$BST" -C "$PROJECT_DIR" "$@"
